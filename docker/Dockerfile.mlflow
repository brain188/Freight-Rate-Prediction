# syntax=docker/dockerfile:1
#
# The MLflow tracking server. A plain image rather than the official one, so
# the Postgres driver is present and the version is pinned alongside the rest
# of the project.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 mlflow

RUN pip install --upgrade pip \
    && pip install "mlflow>=2.15,<4" "psycopg2-binary>=2.9,<3"

# Artifacts are written here, and compose mounts a volume over it so runs
# survive a rebuild.
RUN mkdir -p /mlartifacts && chown mlflow:mlflow /mlartifacts

USER mlflow
WORKDIR /home/mlflow

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:5000/health || exit 1

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "postgresql://freight:freight@db:5432/mlflow", \
     "--default-artifact-root", "/mlartifacts"]